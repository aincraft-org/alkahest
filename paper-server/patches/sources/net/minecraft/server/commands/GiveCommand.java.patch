+    private static CompletableFuture<Suggestions> suggestItemsWithCustom(
+        final CommandBuildContext context,
+        final SuggestionsBuilder builder
+    ) {
+        final String remaining = builder.getRemaining().toLowerCase(Locale.ROOT);
+        try {
+            for (final dev.mintychochip.customblock.CustomBlockDefinition def
+                : dev.mintychochip.customblock.CustomBlocks.all()) {
+                final String full = def.namespacedKey().toString();
+                final String ns = def.namespacedKey().getNamespace();
+                final String path = def.namespacedKey().getKey();
+                if (remaining.isEmpty()
+                    || SharedSuggestionProvider.matchesSubStr(remaining, full.toLowerCase(Locale.ROOT))
+                    || SharedSuggestionProvider.matchesSubStr(remaining, ns)
+                    || SharedSuggestionProvider.matchesSubStr(remaining, path)) {
+                    builder.suggest(full);
+                }
+            }
+        } catch (final Throwable ignored) {
+            // catalog not ready
+        }
+        final SuggestionsBuilder vanillaBuilder = builder.createOffset(builder.getStart());
+        return new ItemParser(context)
+            .fillSuggestions(vanillaBuilder)
+            .thenApply(vanilla -> Suggestions.merge(builder.getInput(), List.of(builder.build(), vanilla)));
+    }
+    // mintychochip end - parse item word via ItemParser
